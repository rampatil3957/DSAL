#include <stdio.h>
#include <stdlib.h>
struct node {
int data;
struct node *left, *right;
};
// Function to create new node
struct node* createNode(int value) {
struct node* newNode = (struct node*)malloc(sizeof(struct node));
newNode->data = value;
newNode->left = newNode->right = NULL;
return newNode;
}
// Function to insert node (BST style for simplicity)
struct node* insert(struct node* root, int value) {
if (root == NULL)
return createNode(value);
if (value < root->data)
root->left = insert(root->left, value);
else
root->right = insert(root->right, value);
return root;
}
// Function to count nodes
void countNodes(struct node* root, int *leaf, int *internal, int *oneChild) {
if (root == NULL)
return;
if (root->left == NULL && root->right == NULL)
(*leaf)++;
else if (root->left != NULL && root->right != NULL)
(*internal)++;



else
(*oneChild)++;
countNodes(root->left, leaf, internal, oneChild);
countNodes(root->right, leaf, internal, oneChild);
}
int main() {
struct node* root = NULL;
int n, val;
int leaf = 0, internal = 0, oneChild = 0;
printf("Enter number of nodes: ");
scanf("%d", &n);
printf("Enter %d node values:\n", n);
for (int i = 0; i < n; i++) {
scanf("%d", &val);
root = insert(root, val);
}
countNodes(root, &leaf, &internal, &oneChild);
printf("\nLeaf Nodes = %d", leaf);
printf("\nInternal Nodes = %d", internal);
printf("\nNodes with One Child = %d\n", oneChild);
return 0;
}

