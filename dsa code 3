#include <stdio.h>
#include <string.h>
// Sequential Search Function
int sequentialSearch(char contacts[][20], int n, char target[]) {
int i;
for (i = 0; i < n; i++) {
if (strcmp(contacts[i], target) == 0) {
return i; // Found
}
}
return -1; // Not found
}
// Binary Search Function (needs sorted array)
int binarySearch(char contacts[][20], int n, char target[]) {
int low = 0, high = n - 1, mid, cmp;
while (low <= high) {
mid = (low + high) / 2;
cmp = strcmp(contacts[mid], target);
if (cmp == 0)
return mid; // Found
else if (cmp > 0)
high = mid - 1; // Search left
else
low = mid + 1; // Search right
}
return -1; // Not found
}
int main() {
char contacts[5][20] = {"Amit", "Baby", "Chatur", "Danish", "Ira"};
char name[20];
int pos;
printf("Enter name to search: ");
scanf("%s", name);
// Sequential Search
pos = sequentialSearch(contacts, 5, name);
if (pos != -1)
printf("Sequential Search: %s found at position %d\n", name, pos + 1);
else
printf("Sequential Search: %s not found\n", name);
// Binary Search
pos = binarySearch(contacts, 5, name);
if (pos != -1)
printf("Binary Search: %s found at position %d\n", name, pos + 1);
else
printf("Binary Search: %s not found\n", name);
return 0;
}
