Program:
#include <stdio.h>
#include <stdlib.h>
struct node {
int data;
struct node *left, *right;
};
// Function to create a new node
struct node* createNode(int value) {
struct node* newNode = (struct node*)malloc(sizeof(struct node));
newNode->data = value;
newNode->left = newNode->right = NULL;
return newNode;
}
// Insert a node into BST
struct node* insert(struct node* root, int value) {
if (root == NULL)
return createNode(value);
if (value < root->data)
root->left = insert(root->left, value);
else if (value > root->data)
root->right = insert(root->right, value);
return root;
}
// Function to find height of BST
int height(struct node* root) {
if (root == NULL)
return -1;
int left = height(root->left);
int right = height(root->right);
return (left > right ? left : right) + 1;
}
// Function to find depth of a given node
int depth(struct node* root, int key) {
int d = 0;
while (root != NULL) {
if (key == root->data)

return d;
else if (key < root->data)
root = root->left;
else
root = root->right;
d++;
}
return -1; // Node not found
}
int main() {
struct node* root = NULL;
int n, val, key;
printf("Enter number of nodes: ");
scanf("%d", &n);
printf("Enter %d values:\n", n);
for (int i = 0; i < n; i++) {
scanf("%d", &val);
root = insert(root, val);
}
printf("\nHeight of the tree = %d\n", height(root));
printf("Enter node value to find depth: ");
scanf("%d", &key);
int d = depth(root, key);
if (d != -1)
printf("Depth of node %d = %d\n", key, d);
else
printf("Node not found.\n");
return 0;
}


