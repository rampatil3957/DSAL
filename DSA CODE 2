#include <stdio.h>



int main() {
int i, j, k, space;
int rows = 4;
for (i = 1; i <= rows; i++) {
for (space = 1; space <= rows - i; space++) { // Print leading spaces
printf(" ");
}

for (j = 0; j < i; j++) { // Print increasing characters
printf("%c", 'A' + j);
}
for (k = i - 2; k >= 0; k--) { // Print decreasing characters
printf("%c", 'A' + k);
}
printf("\n");
}
return 0;
}
