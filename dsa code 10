#define MAX 10
int graph[MAX][MAX];
int visited[MAX];
int queue[MAX];
int front = -1, rear = -1;
// Function to add element to queue
void enqueue(int v) {
if (rear == MAX - 1)
return;
if (front == -1)
front = 0;
queue[++rear] = v;
}
// Function to remove element from queue
int dequeue() {
if (front == -1 || front > rear)
return -1;
return queue[front++];
}
